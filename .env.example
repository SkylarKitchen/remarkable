# Find these in https://sanity.io/manage (or run `npx sanity init`)
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"

# Date in YYYY-MM-DD form. Bump this when you want the newest API features.
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# A read token with "Viewer" rights. Required for draft mode / Presentation.
# Create one at https://sanity.io/manage -> API -> Tokens.
SANITY_API_READ_TOKEN="your-read-token"
